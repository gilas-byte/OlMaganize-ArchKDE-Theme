; Fonte do kvconfig do tema. generate.py troca os @...@ (geometria derivada da paleta) e grava
; templates/theme.kvconfig; o render troca as cores ($${token}). Estrutura baseada no KvFlat
; (Tsu Jan, tema que acompanha o Kvantum, GPL-3.0-or-later).
[%General]
author=${theme_name} (baseado no KvFlat de Tsu Jan)
comment=Marrons quentes com botões de tecla. Paleta do Primary for Obsidian (Cecilia May).
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
joined_inactive_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=0
; Menus e popups: translúcidos (opacidade no SVG, surface.float_opacity) e com blur do
; KWin atrás. Janelas continuam opacas.
composite=true
translucent_windows=false
blurring=false
popup_blurring=true
menu_shadow_depth=8
menu_blur_radius=10
tooltip_shadow_depth=0
tooltip_blur_radius=4
spread_menuitems=false
menu_separator_height=9
submenu_overlap=0
splitter_width=7
scroll_width=10
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=false
combo_as_lineedit=true
combo_focus_rect=false
inline_spin_indicators=true
slider_width=6
slider_handle_width=16
slider_handle_length=16
check_size=16
animate_states=true
dark_titlebar=true
respect_DE=true

[GeneralColors]
window.color=${base_100}
base.color=${base_100}
alt.base.color=${base_110}
button.color=${base_120}
light.color=${base_80}
mid.light.color=${base_90}
dark.color=${base_140}
mid.color=${base_110}
shadow.color=${base_140}
highlight.color=${selection_bg}
inactive.highlight.color=${selection_bg_subtle}
tooltip.base.color=${base_140}
text.color=${base_20}
window.text.color=${base_20}
button.text.color=${base_20}
disabled.text.color=${base_60}
tooltip.text.color=${base_20}
highlight.text.color=${selection_fg}
link.color=${sem_blue}
link.visited.color=${accent_secondary}
progress.indicator.text.color=${base_140}

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_menutitle=true
iconless_pushbutton=false

; --- teclas ------------------------------------------------------------------------------
; frame = raio (cantos inteiros na borda); embaixo, raio + sombra curta.
[PanelButtonCommand]
frame=true
frame.element=button
frame.top=7
frame.bottom=9
frame.left=7
frame.right=7
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
focusFrame=true
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${base_20}
text.toggle.color=${selection_fg}
text.shadow=false
text.margin=true
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4
text.iconspacing=4
min_width=+0.5font

[PanelButtonTool]
inherits=PanelButtonCommand
text.margin.left=2
text.margin.right=2
min_width=0

[ToolbarButton]
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${base_20}
text.toggle.color=${selection_fg}

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
focusFrame=false
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false
focusFrame=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
focusFrame=false
text.bold=true

; --- campos (afundados, sem base inferior) -----------------------------------------------
[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
focusFrame=false
text.margin.left=2
text.margin.right=2

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo
indicator.element=arrow
focusFrame=false
text.press.color=${base_20}
text.toggle.color=${base_20}

[ToolbarComboBox]
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${base_20}
text.toggle.color=${base_20}

; --- checkbox e radio (ligado = amarelo de conteúdo, marca escura) ---------------------
[RadioButton]
inherits=PanelButtonCommand
frame=false
focusFrame=false
interior.element=radio
text.focus.color=${base_10}
text.toggle.color=${base_20}

[CheckBox]
inherits=PanelButtonCommand
frame=false
focusFrame=false
interior.element=checkbox
text.focus.color=${base_10}
text.toggle.color=${base_20}

[Focus]
frame=true
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

; --- listas e árvores --------------------------------------------------------------------
[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
focusFrame=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${selection_fg}
text.toggle.color=${selection_fg}
text.toggle.inactive.color=${selection_fg}
min_width=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
focusFrame=false
indicator.element=tree
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
focusFrame=false
frame.top=0
frame.bottom=1
frame.left=0
frame.right=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=${base_40}
text.focus.color=${base_20}
text.press.color=${base_10}
text.toggle.color=${base_20}
min_width=0

[GenericFrame]
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=false
text.margin=0
text.normal.color=${base_20}

[StatusBar]
frame=false
interior=false

[Window]
interior=false

; --- abas: ativa = base.100 com linha amarela de 2px -------------------------------------
[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=9
focusFrame=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.normal.color=${base_40}
text.focus.color=${base_20}
text.press.color=${base_10}
text.toggle.color=${base_10}
min_width=0
min_height=2font

[TabFrame]
frame=true
frame.element=tabframe
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[TabBarFrame]
frame=false
interior=false

; --- rolagem, sliders, progresso ---------------------------------------------------------
[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[ScrollbarGroove]
frame=false
interior=true
interior.element=scrollbargroove

[ScrollbarSlider]
frame=true
frame.element=scrollbarslider
interior=true
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
indicator.element=grip
indicator.size=8

[Slider]
frame=true
frame.element=slider
interior=true
interior.element=slider
focusFrame=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
frame=true
frame.element=progress
interior=true
interior.element=progress
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=0
text.normal.color=${base_20}
text.focus.color=${base_20}
text.press.color=${base_20}
text.toggle.color=${base_20}
text.bold=false

[ProgressbarContents]
frame=true
frame.element=progress-pattern
interior=true
interior.element=progress-pattern
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

; --- menus e dicas -----------------------------------------------------------------------
[Menu]
frame=true
frame.element=menu
interior=true
interior.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.normal.color=${base_20}

[MenuItem]
frame=true
frame.element=menuitem
interior=true
interior.element=menuitem
indicator.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=4
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${base_10}
text.toggle.color=${base_10}
min_width=0

[MenuBar]
frame=false
interior=false
text.normal.color=${base_20}

[MenuBarItem]
frame=true
frame.element=menubaritem
interior=true
interior.element=menubaritem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=4
text.normal.color=${base_20}
text.focus.color=${base_10}
text.press.color=${base_10}
text.toggle.color=${base_10}

[ToolTip]
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=0
text.normal.color=${base_20}

; --- barras e divisores ------------------------------------------------------------------
[Toolbar]
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.normal.color=${base_20}

[Splitter]
frame=false
interior=true
interior.element=splitter
indicator.element=splitter-grip
indicator.size=16

[SizeGrip]
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13
