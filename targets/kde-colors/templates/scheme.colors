# Esquema de cores ${theme_name}. Gerado a partir de palette.toml — não editar à mão.
# Paleta base: Primary for Obsidian, de Cecilia May.

[ColorEffects:Disabled]
Color=${base_120_rgb}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${base_110_rgb}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=${base_110_rgb}
BackgroundNormal=${base_120_rgb}
DecorationFocus=${accent_primary_rgb}
DecorationHover=${base_70_rgb}
ForegroundActive=${base_10_rgb}
ForegroundInactive=${base_40_rgb}
ForegroundLink=${sem_blue_rgb}
ForegroundNegative=${sem_red_rgb}
ForegroundNeutral=${sem_orange_rgb}
ForegroundNormal=${base_20_rgb}
ForegroundPositive=${sem_green_rgb}
ForegroundVisited=${accent_secondary_rgb}

